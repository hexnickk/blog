{
  "name": "blog",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev --host 0.0.0.0",
    "start": "vite preview --outDir build/client --host 0.0.0.0",
    "typecheck": "react-router typegen && tsc --noEmit",
    "fmt": "npm run format",
    "format": "oxfmt .oxfmtrc.json .oxlintrc.json .devcontainer package.json tsconfig*.json vite.config.ts app react-router.config.ts",
    "format:check": "oxfmt --check .oxfmtrc.json .oxlintrc.json .devcontainer package.json tsconfig*.json vite.config.ts app react-router.config.ts",
    "lint": "npm run format:check && oxlint ."
  },
  "dependencies": {
    "@react-router/node": "^7.5.3",
    "@stylexjs/stylex": "^0.19.1",
    "isbot": "^5.1.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.3"
  },
  "devDependencies": {
    "@react-router/dev": "^7.5.3",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/node": "^20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
